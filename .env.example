# 이 파일을 참고해서 src/main/resources/application-local.yml 을 작성하세요.
# application-local.yml 은 .gitignore 처리되어 있으므로 git에 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mariadb://localhost:3306/collab_test
    username: root
    password: your-db-password

  data:
    redis:
      host: localhost
      port: 6379
      password:

  mail:
    username: your-gmail@gmail.com
    password: your-gmail-app-password  # Gmail 앱 비밀번호 (일반 비밀번호 아님)

jwt:
  secret: your-random-256bit-hex-string  # 랜덤 문자열, 외부 발급 아님

file:
  upload-dir: ./uploads

cors:
  allowed-origins: http://localhost:3000
